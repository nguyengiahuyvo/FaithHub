{
  "expo": {
    "name": "FaithHub",
    "slug": "FaithHub",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon/ios/AppIcon~ios-marketing.png",
    "scheme": "faithhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon/ios/AppIcon~ios-marketing.png",
      "bundleIdentifier": "com.nguyengiahuy.vo.FaithHub",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/images/icon/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/images/icon/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nguyengiahuy.vo.FaithHub",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon/ios/AppIcon-29@2x.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon/android/play_store_512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F7F4",
          "dark": {
            "backgroundColor": "#1F3B2E"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
          "color": "#5B7553"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "982c36e4-13fe-4ed4-adf7-482e715dda00"
      }
    },
    "owner": "nguyengiahuy.vo"
  }
}
